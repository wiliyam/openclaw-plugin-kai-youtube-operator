{
  "name": "openclaw-plugin-kai-youtube-operator",
  "version": "0.3.1",
  "description": "OpenClaw plugin for safe YouTube Studio, channel-manager, live-stream, and short-video editing workflows for Kai.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci": "npm run lint && npm run quality && npm test && npm run build && npm run plugin:validate && npm run security",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "plugin:build": "npm run build && node scripts/validate-plugin.mjs",
    "plugin:validate": "npm run build && node scripts/validate-plugin.mjs",
    "plugin:validate:openclaw": "npm run build && openclaw plugins validate --root . --entry ./dist/index.js",
    "quality": "node scripts/check-quality.mjs",
    "security": "npm audit --audit-level=high",
    "security:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiliyam/openclaw-plugin-kai-youtube-operator.git"
  }
}
